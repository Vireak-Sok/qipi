# Use .env.local for development or Vercel environment settings for deployments.
# All three are required on Vercel. The secret key never goes to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# The browser receives only this publishable key and SUPABASE_URL via /api/config.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: enables the private moderation dashboard.
QIPI_ADMIN_TOKEN=replace-with-a-long-random-secret
